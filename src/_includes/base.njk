<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Luís Silva</title>
  <meta name="description" content="{{ description or 'IoT, embedded systems, automation and DIY electronics by Luís Silva.' }}">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
